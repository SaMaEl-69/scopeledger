# Copy outside the source tree to /etc/scopeledger/server.env; chmod 600.
# Fill privately. Empty identity/secret fields deliberately prevent activation.
PORT=4173
NODE_ENV=production
SCOPELEDGER_MODE=live
SCOPELEDGER_ORIGIN=https://scopeledger.site
SCOPELEDGER_DB_PATH=/var/lib/scopeledger/licenses.sqlite
SCOPELEDGER_SESSION_SECRET=
SCOPELEDGER_CHROME_PATH=/usr/bin/chromium
SCOPELEDGER_GUMROAD_SELLER_ID=
SCOPELEDGER_GUMROAD_INDIVIDUAL_PRODUCT_ID=
SCOPELEDGER_GUMROAD_AGENCY_PRODUCT_ID=
SCOPELEDGER_INDIVIDUAL_CHECKOUT_URL=
SCOPELEDGER_AGENCY_CHECKOUT_URL=
SCOPELEDGER_SELLER_VERIFIED=false
SCOPELEDGER_TRUST_LOOPBACK_PROXY=false
SCOPELEDGER_PURCHASES_ENABLED=false
SCOPELEDGER_LAUNCH_APPROVED=false
SCOPELEDGER_LOG_EVENTS=true
